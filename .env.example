# Router environment template.
#
# Copy to .env.local and fill in. docker-compose loads .env.local
# automatically; `make dev` reads it via godotenv.
#
# Anything marked REQUIRED must be set for the router to boot.
# Anything else is optional with the documented default.

# --------------------------------------------------------------------
# Database (REQUIRED — set DATABASE_URL or all four POSTGRES_* vars).
# --------------------------------------------------------------------

# Full Postgres connection string. Takes precedence over POSTGRES_* below.
# DATABASE_URL=postgresql://router:router@localhost:5433/router?sslmode=disable

# DEV ONLY defaults — match docker-compose.yml. Replace in any deployment.
POSTGRES_USER=router
POSTGRES_PASSWORD=router
POSTGRES_DB=router
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require       # set to `disable` for local Docker
# POSTGRES_CONNECTION_NAME=    # Cloud SQL Auth Proxy instance name

# --------------------------------------------------------------------
# Provider API keys.
# This deployment is ai&-only: the sole registered upstream provider is
# ai& (aiand.com), an OpenAI-compatible open-weight inference surface.
# Models use ai& namespaced IDs (zai-org/glm-5.2, etc.) via the catalog.
# --------------------------------------------------------------------

AIAND_API_KEY=sk-your-aiand-api-key
# AIAND_API_URL=https://api.aiand.com/v1   # default; override for a custom endpoint
# AIAND_IDENTITY_URL=https://api.aiand.com   # dashboard login probe root (defaults separately from AIAND_API_URL)

# --------------------------------------------------------------------
# Server.
# --------------------------------------------------------------------

PORT=8080
# Single "hosted" mode: the dashboard lives at /ui/* and its data plane at
# /v1/*; operators authenticate with their ai& sk- key. There is no separate
# admin API and no admin password.

# Refuse upstream connections that resolve outside the public internet
# (loopback, private, link-local, carrier-grade NAT). Set explicitly to override.
# MUTEX: while on, provider adapters ignore HTTP_PROXY/HTTPS_PROXY — a proxied
# connection hides the destination from the dial check, so setting a proxy
# routes upstreams DIRECT, never through the proxy.
# ROUTER_RESTRICT_UPSTREAM_EGRESS=false

# Cookie security flag for the dashboard. Set to `true` only when
# serving the dashboard over plain HTTP (e.g. local dev without TLS).
# ROUTER_COOKIE_INSECURE=false

# --------------------------------------------------------------------
# Routing.
# --------------------------------------------------------------------

# Pin a specific cluster artifact version (e.g. `v0.27`). Unset = use
# the version named in internal/router/cluster/artifacts/latest.
# ROUTER_CLUSTER_VERSION=

# Build a Scorer for every committed bundle so callers can A/B versions
# per-request via the `x-weave-cluster-version` header. Default false:
# prod loads only the served default version. Set true on staging/eval
# deployments where the eval harness flips between versions.
# ROUTER_CLUSTER_BUILD_ALL_VERSIONS=false

# Opt-in routing strategies (selected per-request via x-weave-router-strategy).
# Unset = strategy header returns HTTP 503 for that arm; default traffic uses cluster.
# ROUTER_RL_SIDECAR_URL=          # rl strategy → router-rl-sidecar Cloud Run or Modal band serve
# ROUTER_RL_SIDECAR_TIMEOUT_MS=10000
# ROUTER_RL_SIDECAR_MODAL_KEY=    # Modal-Key when URL is a requires_proxy_auth ASGI app
# ROUTER_RL_SIDECAR_MODAL_SECRET=
# ROUTER_HMM_SIDECAR_URL=         # set automatically by `make up-hmm`
# ROUTER_BANDIT_POSTERIOR_FILE=   # bandit strategy → ts_posterior.json from train_thompson_posterior.py

# Frozen HMM companion container (`make up-hmm`). The published v1 artifact
# was trained in google/gemini-embedding-2's exact 3072-dimensional vector
# space. A different same-dimension model is not compatible; readiness verifies
# the provider with a reference-vector probe before serving.
# HMM_PACKAGE_URL=https://github.com/workweave/router/releases/download/hmm-model-v1/hmm-router-frozen-v1.tar.gz
# HMM_PACKAGE_SHA256=b326bda644aac86831bae47d0b69de008046f62324a4b93a1eba702581c174df
# HMM_EMBEDDING_PROVIDER=google
# GOOGLE_API_KEY=...

# OpenAI-compatible embedding transport. It must expose the same Google model
# and pass the artifact probe; arbitrary Ollama/vLLM embeddings need their own
# separately trained HMM package.
# HMM_EMBEDDING_PROVIDER=openai-compatible
# HMM_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# HMM_EMBEDDING_API_KEY=
# HMM_EMBEDDING_MODEL=google/gemini-embedding-2

# Per-request ONNX embed timeout. Increase on slower hosts.
ROUTER_CLUSTER_EMBED_TIMEOUT_MS=200

# Feed the last user message to the embedder instead of concatenated context.
ROUTER_EMBED_LAST_USER_MESSAGE=false

# Cost-comparison baseline for inbound model names that have no pricing
# entry (e.g. custom IDE model names like "weave-router"). Savings markers
# and dashboard cost math fall back to this model's pricing. Set to empty
# to disable substitution (savings show $0 for unknown requested models).
ROUTER_DEFAULT_BASELINE_MODEL=deepseek-ai/deepseek-v4-flash

# Pin a session to its first-routed model so multi-turn conversations stay
# coherent. Disable only if you want every turn re-routed independently.
ROUTER_SESSION_PIN_ENABLED=true

# Reuse routing decisions per API key for this many ms (0 = disabled).
ROUTER_STICKY_DECISION_TTL_MS=0

# Hard pins — bypass the cluster scorer entirely. Debugging only.
# ROUTER_HARD_PIN_MODEL=
# ROUTER_HARD_PIN_EXPLORE=true  # default true — set false to let Explore sub-agents go through the scorer

# Route Task-tool sub-agents to a distinct catalog model/provider,
# independent of ROUTER_HARD_PIN_MODEL above — e.g. a local OpenAI-compatible
# endpoint while the main loop keeps routing normally. Both must be set
# together. Use aiand catalog IDs (e.g. deepseek-ai/deepseek-v4-flash).
# ROUTER_SUBAGENT_MODEL=

# Semantic cache for routing decisions (optional).
# ROUTER_SEMANTIC_CACHE_ENABLED=false
# ROUTER_SEMANTIC_CACHE_BUCKET=
# ROUTER_SEMANTIC_CACHE_TTL_SEC=300

# Prism-style cache-aware planner. Decides per turn whether to stay on the
# pinned model or switch, weighing prompt-cache eviction cost against the
# cluster scorer's expected savings.

# Kill switch. When false the router falls back to first-decision-wins
# (pin lookup + scorer fallback, no EV math).
# ROUTER_PLANNER_ENABLED=true

# When true (default) pinned tool_result turns run the scorer + planner just
# like MainLoop, so the fresh cluster decision is computed and logged on every
# turn and the planner may switch on EV grounds. When false, tool_result turns
# reuse the pin verbatim with no scorer call (the cheaper legacy hot path).
# ROUTER_SCORE_TOOL_RESULT_TURNS=true

# Defensive backstop for upstream cyber-safety refusals. When true, a safety
# refusal observed on the response stream re-pins the session off the refusing
# model to a non-refusing one, so the rest of the session routes around it.
# Detection is observe-only (forwarded bytes are never modified). Default off.
# ROUTER_CYBER_REFUSAL_REPIN=false
# Re-pin target when the session pin carries no runner-up (PairedModel).
# ROUTER_CYBER_REFUSAL_FALLBACK_MODEL=moonshotai/kimi-k2.7

# Minimum positive expected value (USD, over the remaining-turn horizon)
# required to evict a pinned model. Lower = more switches, higher = stickier.
# ROUTER_SWITCH_EV_THRESHOLD_USD=0.001

# Horizon used to amortize per-turn savings. Matches typical agentic-loop
# tail length; bump for long-running sessions to make switches more eager.
# ROUTER_SWITCH_EXPECTED_REMAINING_TURNS=3

# Corrected cache economics for the STAY/SWITCH planner. OFF by default: it
# changes routing, so arm it per environment (staging first) rather than by
# merging.
#
# Off, a turn is priced as if the WHOLE prompt were cache-resident. Real
# cacheable share is 0.77-0.91, so 10-25% of a large prompt is billed at full
# rate -- and that tail is exactly where the price gap between two models
# applies undiscounted. Measured over 30 days of production the legacy model
# understates a turn's cost ~11x (cost-weighted bias -91%).
#
# On, the planner prices each side at price*(1 - k*(1-m)) with k measured from
# the pin's own previous turn, charges the cache-WRITE premium (w-m) on a
# switch instead of (1-m), and counts output price -- which it is otherwise
# blind to, so a model many times dearer per output token can score
# EV-positive on input alone. Replaying 11,864 real sessions cut cost
# 12.7-14.1%.
# ROUTER_SWITCH_CORRECTED_ECONOMICS=false

# Handover summarizer (called on switch turns to bound the new model's first
# input cost). When the named provider isn't registered, the orchestrator
# falls back to handover.TrimLastN instead. Defaults match aiand catalog.
# ROUTER_HANDOVER_MODEL=deepseek-ai/deepseek-v4-flash
# ROUTER_HANDOVER_TIMEOUT_MS=3000

# ONNX runtime asset paths. The Docker image pre-populates these; only
# matters for `make dev` on Apple Silicon / non-default Linux setups.
# ROUTER_ONNX_ASSETS_DIR=/opt/router/assets
# ROUTER_ONNX_LIBRARY_DIR=/opt/homebrew/lib   # Apple Silicon brew default

# --------------------------------------------------------------------
# BYOK encryption.
# --------------------------------------------------------------------

# Tink AES-256-GCM keyset (JSON) used to encrypt customer-supplied upstream
# provider keys at rest. If unset, BYOK secrets are stored unencrypted and
# the router logs a WARN at startup. REQUIRED in any deployment that
# handles real customer secrets.
# Generate: tinkey create-keyset --key-template AES256_GCM --out-format json
# EXTERNAL_KEY_ENCRYPTION_KEY=

# --------------------------------------------------------------------
# Telemetry (OpenTelemetry).
# Setting OTEL_EXPORTER_OTLP_ENDPOINT enables async OTLP/HTTP span export.
# When unset, OTel is fully disabled at zero runtime cost.
# --------------------------------------------------------------------

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_TOKEN
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# OTEL_SERVICE_NAME=router
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=1.0.0

# Batch span processor tuning.
# OTEL_BSP_MAX_QUEUE_SIZE=1000
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=50
# OTEL_BSP_SCHEDULE_DELAY=500
# OTEL_EXPORT_WORKERS=2

# --------------------------------------------------------------------
# Feedback pages removed.
#
# /v1/feedback/* HTTP pages are no longer mounted. ROUTER_FEEDBACK_* env vars
# are ignored (left here so existing deploys do not fail on unknown keys).
# Analytics export (/v1/analytics/*) remains available with ra_ keys.
# --------------------------------------------------------------------

# ROUTER_FEEDBACK_LINK_SECRET=  # ignored
# ROUTER_FEEDBACK_BASE_URL=     # ignored
# ROUTER_FEEDBACK_LINK_TTL_SEC= # ignored

# --------------------------------------------------------------------
# Logging / debug.
# --------------------------------------------------------------------

# --------------------------------------------------------------------

# slog level: debug | info | warn | error.
LOG_LEVEL=info

# Log handler format: json | text | color (alias: tint). Unset = auto: a TTY
# gets human-readable output (colorized unless NO_COLOR/LOG_COLOR disables it),
# everything else (Cloud Run, piped) gets GCP-structured JSON so
# severity/timestamp/message map onto Cloud Logging fields.
# LOG_FORMAT=json

# Verbose proxy tracing. Off in production — these are very noisy.
# ROUTER_DEBUG_WRITER_TRACE=false

# --------------------------------------------------------------------
# CGO / build (only relevant for `make dev` on Apple Silicon).
# Pre-built static lib from https://github.com/daulet/tokenizers/releases.
# --------------------------------------------------------------------

# CGO_LDFLAGS=-L/path/to/libtokenizers
