# Production Environment Configuration for build.io Deployment
# Copy to .env.buildio.local and fill in required values

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL password for router user
POSTGRES_PASSWORD: changeme_production_password

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
ROUTER_DEPLOYMENT_MODE: selfhosted
PORT: "8080"
ROUTER_CLUSTER_VERSION: v0.76
ROUTER_CLUSTER_BUILD_ALL_VERSIONS: "false"

# =============================================================================
# PROVIDER API KEYS (REQUIRED for selfhosted mode)
# =============================================================================
AIAND_API_KEY: sk-c5e92832a003a63ce5f121c714beff02ffc987018c38438900fcd8d229dc76aa
AIAND_API_URL: https://api.aiand.com/v1

# =============================================================================
# ADMIN DASHBOARD
# =============================================================================
ROUTER_ADMIN_PASSWORD: secure_admin_password_change_me

# =============================================================================
# BYOK ENCRYPTION (REQUIRED for production with customer keys)
# =============================================================================
# Generate with: tinkey create-keyset --key-template AES256_GCM --out-format json
EXTERNAL_KEY_ENCRYPTION_KEY: "{\"keyData\":{... Tink keyset JSON...}}"

# =============================================================================
# TELEMETRY / OTEL
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT: https://your-otel-collector.example.com/v1/traces
OTEL_SERVICE_NAME: router

# =============================================================================
# PUBSUB FOR CACHE INVALIDATION
# =============================================================================
PUBSUB_PROJECT_ID: router-prod
PUBSUB_TOPIC_ROUTER_INVALIDATION: router-installation-invalidate
PUBSUB_SUBSCRIPTION_ROUTER_INVALIDATION: router-installation-invalidate

# =============================================================================
# DEPLOYMENT METADATA (set by CI/CD)
# =============================================================================
GIT_COMMIT: latest
BUILD_TIME: "2026-08-24T00:00:00Z"
PR_NUMBER: ""
SERVER_REPLICAS: "2"

# =============================================================================
# OPTIONAL: SITE FEEDBACK LINK
# =============================================================================
ROUTER_FEEDBACK_LINK_SECRET: feedback-link-secret-here
ROUTER_FEEDBACK_BASE_URL: https://router.example.com

# =============================================================================
# OPTIONAL: FEATURE FLAGS
# =============================================================================
ROUTER_CYBER_REFUSAL_REPIN: "true"
ROUTER_CYBER_REFUSAL_FALLBACK_MODEL: claude-sonnet-5
ROUTER_SWITCH_EV_THRESHOLD_USD: "0.001"
ROUTER_PLANNER_ENABLED: "true"
ROUTER_SEMANTIC_CACHE_ENABLED: "true"

# =============================================================================
# OPTIONAL: SUBAGENT ROUTING
# =============================================================================
ROUTER_SUBAGENT_MODEL: claude-sonnet-4-5
ROUTER_SUBAGENT_PROVIDER: aiand

# =============================================================================
# OPTIONAL: BANDIT EXPLORATION (staging only)
# =============================================================================
ROUTER_EXPLORE_ENABLED: "false"
ROUTER_EXPLORE_EPSILON: "0.05"
